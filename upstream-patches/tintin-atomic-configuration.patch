new file mode 100644
index 0000000..967f503
--- /dev/null
+++ b/src/control-model-scope.ts
@@ -0,0 +1,55 @@
+/** Strict, uncached scope for explicit child controls; legacy launch policy is unchanged. */
+import { readFileSync } from "node:fs";
+import { join } from "node:path";
+import type { Api, Model } from "@earendil-works/pi-ai";
+import type { ExtensionContext } from "@earendil-works/pi-coding-agent";
+import * as piSdk from "@earendil-works/pi-coding-agent";
+
+export type ControlScopeResolver = (patterns: string[], models: readonly Model<Api>[]) => {
+  scopedModels: { model: Model<Api>; thinkingLevel?: string }[];
+  diagnostics: readonly unknown[];
+};
+
+export function controlScopeResolver(): ControlScopeResolver | undefined {
+  // Namespace lookup avoids requiring a named export that Pi 0.84.2 lacks.
+  if (!("resolveModelScopeFromModels" in piSdk)) return undefined;
+  const resolve = (piSdk as unknown as { resolveModelScopeFromModels?: ControlScopeResolver }).resolveModelScopeFromModels;
+  return typeof resolve === "function" ? resolve : undefined;
+}
+
+function readPatterns(path: string): string[] | undefined {
+  let text: string;
+  try { text = readFileSync(path, "utf8"); }
+  catch (error) {
+    if ((error as NodeJS.ErrnoException).code === "ENOENT") return undefined;
+    throw error;
+  }
+  const settings: unknown = JSON.parse(text);
+  if (!settings || typeof settings !== "object" || Array.isArray(settings)) throw new Error("Invalid settings");
+  if (!("enabledModels" in settings)) return undefined;
+  const patterns = settings.enabledModels;
+  if (!Array.isArray(patterns) || !patterns.every(p => typeof p === "string" && p.trim().length > 0)) throw new Error("Invalid enabledModels");
+  return patterns;
+}
+
+/** Undefined means authorized; diagnostics and restricted-empty sets never widen scope. */
+export function checkControlScope(
+  cwd: string,
+  registry: ExtensionContext["modelRegistry"],
+  target?: { provider: string; id: string },
+): "unsupported" | "scope-unknown" | "scope-denied" | undefined {
+  const resolve = controlScopeResolver();
+  if (!resolve) return "unsupported";
+  try {
+    const global = readPatterns(join(piSdk.getAgentDir(), "settings.json"));
+    const project = readPatterns(join(cwd, ".pi", "settings.json"));
+    const patterns = project ?? global;
+    if (!patterns?.length) return undefined;
+    // A model candidate shortlist is not a scope universe. Do not cache by patterns alone.
+    const models = registry.getAvailable?.() ?? registry.getAll();
+    const result = resolve(patterns, models);
+    if (result.diagnostics.length || result.scopedModels.length === 0) return "scope-denied";
+    if (target && !result.scopedModels.some(({ model }) => model.provider === target.provider && model.id === target.id)) return "scope-denied";
+    return undefined;
+  } catch { return "scope-unknown"; }
+}
diff --git a/src/idle-child-configuration.ts b/src/idle-child-configuration.ts
new file mode 100644
index 0000000..f6c2e2d
--- /dev/null
+++ b/src/idle-child-configuration.ts
@@ -0,0 +1,179 @@
+/** Public structural compatibility with Pi's additive atomic configuration API.
+ * Kept local so ordinary Agent loading still works on Pi 0.84.2.
+ */
+import type { ExtensionContext } from "@earendil-works/pi-coding-agent";
+import type { AgentManager } from "./agent-manager.js";
+import { checkControlScope, controlScopeResolver } from "./control-model-scope.js";
+import type { AgentRecord, ThinkingLevel } from "./types.js";
+
+export interface ChildConfigurationSnapshot {
+  readonly sessionId: string;
+  readonly revision: number;
+  readonly model: Readonly<{ provider: string; id: string }> | undefined;
+  readonly thinkingLevel: ThinkingLevel;
+}
+export type ChildConfigurationReason = "busy" | "disposed" | "stale" | "invalid" | "unauthorized" | "cancelled" | "operation-conflict" | "capacity" | "storage" | "unsupported" | "not-found" | "scope-unknown" | "scope-denied";
+export interface ChildConfigurationReceipt {
+  readonly status: "committed" | "noop";
+  readonly operationId: string;
+  readonly before: ChildConfigurationSnapshot;
+  readonly after: ChildConfigurationSnapshot;
+  readonly revision: number;
+  readonly notificationErrors: readonly string[];
+}
+export type ChildConfigurationResult = ChildConfigurationReceipt | { status: "rejected"; operationId: string; reason: ChildConfigurationReason };
+export type ChildConfigurationSnapshotResult = { status: "ready"; childId: string; snapshot: ChildConfigurationSnapshot } | { status: "rejected"; reason: ChildConfigurationReason };
+export interface ConfigureIdleChildRequest {
+  operationId: string;
+  childId: string;
+  expectedSessionId: string;
+  expectedRevision: number;
+  model: { provider: string; id: string };
+  thinking: ThinkingLevel;
+  signal?: AbortSignal;
+}
+export interface ChildConfigurationReceiptRequest {
+  operationId: string;
+  childId: string;
+  expectedSessionId: string;
+}
+export interface AtomicConfigurationRequest {
+  operationId: string;
+  expected: ChildConfigurationSnapshot;
+  target: { provider: string; id: string; thinkingLevel: ThinkingLevel };
+  signal?: AbortSignal;
+  validateCommit?: () => boolean;
+}
+export interface AtomicConfigurationSession {
+  getConfigurationSnapshot(): ChildConfigurationSnapshot;
+  configureIfIdle(request: AtomicConfigurationRequest): Promise<ChildConfigurationResult>;
+  getConfigurationReceipt(operationId: string): ChildConfigurationReceipt | undefined;
+}
+export interface ChildControlHost { ctx: ExtensionContext | undefined; epoch: number; ownsRegistry: boolean }
+
+const OPERATION_CAPACITY = 1024;
+const LEVELS: readonly string[] = ["off", "minimal", "low", "medium", "high", "xhigh", "max"];
+type Lease = NonNullable<ReturnType<AgentManager["getIdleChildLease"]>>;
+interface Operation {
+  key: string;
+  signal?: AbortSignal;
+  session: AtomicConfigurationSession;
+  request: AtomicConfigurationRequest;
+  promise: Promise<ChildConfigurationResult>;
+}
+
+export class IdleChildControls {
+  private operations = new WeakMap<AgentRecord, Map<string, Operation>>();
+  constructor(private manager: AgentManager, private getHost: () => ChildControlHost) {}
+
+  private authorize(childId: string): { lease: Lease; session: AtomicConfigurationSession; host: ChildControlHost; valid: () => boolean } | { reason: ChildConfigurationReason } {
+    try {
+      const host = this.getHost();
+      if (!host.ownsRegistry || !host.ctx) return { reason: "unauthorized" };
+      const record = this.manager.getRecord(childId);
+      if (!record) return { reason: "not-found" };
+      const lease = this.manager.getIdleChildLease(childId, host.ctx);
+      if (!lease) return { reason: "unauthorized" };
+      const session = lease.session as unknown as Partial<AtomicConfigurationSession>;
+      if (!controlScopeResolver() || typeof session.getConfigurationSnapshot !== "function" ||
+        typeof session.configureIfIdle !== "function" || typeof session.getConfigurationReceipt !== "function") return { reason: "unsupported" };
+      const registry = host.ctx.modelRegistry;
+      const cwd = host.ctx.cwd;
+      const valid = () => {
+        try {
+          const current = this.getHost();
+          return current.ownsRegistry && current.ctx === host.ctx && current.epoch === host.epoch &&
+            current.ctx?.modelRegistry === registry && current.ctx?.cwd === cwd && lease.valid();
+        } catch { return false; }
+      };
+      return { lease, session: session as AtomicConfigurationSession, host, valid };
+    } catch { return { reason: "unauthorized" }; }
+  }
+
+  getIdleChildConfigurationSnapshot(childId: string): ChildConfigurationSnapshotResult {
+    const auth = this.authorize(childId);
+    if ("reason" in auth) return { status: "rejected", reason: auth.reason };
+    try {
+      const reason = checkControlScope(auth.lease.configCwd, auth.host.ctx!.modelRegistry);
+      if (reason) return { status: "rejected", reason };
+      const snapshot = auth.session.getConfigurationSnapshot();
+      if (!auth.valid()) return { status: "rejected", reason: "unauthorized" };
+      return { status: "ready", childId, snapshot };
+    } catch { return { status: "rejected", reason: "unsupported" }; }
+  }
+
+  configureIdleChild(input: ConfigureIdleChildRequest): Promise<ChildConfigurationResult> {
+    const reject = (reason: ChildConfigurationReason): Promise<ChildConfigurationResult> =>
+      Promise.resolve({ status: "rejected", operationId: input?.operationId, reason });
+    if (!input || typeof input.operationId !== "string" || !input.operationId.length || input.operationId.length > 256 ||
+      typeof input.childId !== "string" || typeof input.expectedSessionId !== "string" ||
+      !Number.isSafeInteger(input.expectedRevision) || input.expectedRevision < 0 ||
+      !input.model || typeof input.model.provider !== "string" || !input.model.provider.length ||
+      typeof input.model.id !== "string" || !input.model.id.length || !LEVELS.includes(input.thinking) ||
+      (input.signal !== undefined && !(input.signal instanceof AbortSignal))) return reject("invalid");
+    const auth = this.authorize(input.childId);
+    if ("reason" in auth) return reject(auth.reason);
+    const { lease, session, host } = auth;
+    const registry = host.ctx!.modelRegistry;
+    const target = Object.freeze({ provider: input.model.provider, id: input.model.id, thinkingLevel: input.thinking });
+    const key = JSON.stringify([input.childId, input.expectedSessionId, input.expectedRevision, target.provider, target.id, target.thinkingLevel]);
+    let cache = this.operations.get(lease.record);
+    const existing = cache?.get(input.operationId);
+    if (existing && (existing.key !== key || existing.signal !== input.signal)) return reject("operation-conflict");
+    const scopeReason = checkControlScope(lease.configCwd, registry, target);
+    if (scopeReason) return reject(scopeReason);
+    let snapshot: ChildConfigurationSnapshot;
+    try { snapshot = session.getConfigurationSnapshot(); } catch { return reject("unsupported"); }
+    if (!auth.valid()) return reject("unauthorized");
+    if (snapshot.sessionId !== input.expectedSessionId) return reject("stale");
+    if (existing) {
+      if (existing.session !== session) return reject("unauthorized");
+      // Receipt lookup during notifications must not await its own notification completion.
+      const receipt = session.getConfigurationReceipt(input.operationId);
+      return receipt ? Promise.resolve(receipt) : existing.promise;
+    }
+    if (snapshot.revision !== input.expectedRevision) return reject("stale");
+    if (cache && cache.size >= OPERATION_CAPACITY) return reject("capacity");
+    const request: AtomicConfigurationRequest = {
+      operationId: input.operationId,
+      expected: snapshot,
+      target,
+      signal: input.signal,
+      validateCommit: () => {
+        try {
+          if (!auth.valid()) return false;
+          const now = session.getConfigurationSnapshot();
+          if (now.sessionId !== snapshot.sessionId || now.revision !== snapshot.revision) return false;
+          if (checkControlScope(lease.configCwd, registry, target) !== undefined) return false;
+          // Scope resolution may be user/provider code. Check identities once more after it.
+          return auth.valid();
+        } catch { return false; }
+      },
+    };
+    // Insert before invoking Pi: public notifications can synchronously reenter us.
+    let resolve!: (result: ChildConfigurationResult) => void;
+    let fail!: (error: unknown) => void;
+    const promise = new Promise<ChildConfigurationResult>((yes, no) => { resolve = yes; fail = no; });
+    if (!cache) { cache = new Map(); this.operations.set(lease.record, cache); }
+    cache.set(input.operationId, { key, signal: input.signal, session, request, promise });
+    try { void session.configureIfIdle(request).then(resolve, fail); } catch (error) { fail(error); }
+    return promise;
+  }
+
+  getIdleChildConfigurationReceipt(input: ChildConfigurationReceiptRequest): ChildConfigurationResult {
+    const reject = (reason: ChildConfigurationReason): ChildConfigurationResult => ({ status: "rejected", operationId: input?.operationId, reason });
+    if (!input || typeof input.operationId !== "string" || typeof input.childId !== "string" || typeof input.expectedSessionId !== "string") return reject("invalid");
+    const auth = this.authorize(input.childId);
+    if ("reason" in auth) return reject(auth.reason);
+    const { session, lease, host } = auth;
+    if (session.getConfigurationSnapshot().sessionId !== input.expectedSessionId) return reject("stale");
+    const operation = this.operations.get(lease.record)?.get(input.operationId);
+    if (!operation) return reject("not-found");
+    if (operation.session !== session) return reject("unauthorized");
+    const reason = checkControlScope(lease.configCwd, host.ctx!.modelRegistry, operation.request.target);
+    if (reason) return reject(reason);
+    const receipt = session.getConfigurationReceipt(input.operationId);
+    if (!auth.valid()) return reject("unauthorized");
+    return receipt ?? reject("not-found");
+  }
+}

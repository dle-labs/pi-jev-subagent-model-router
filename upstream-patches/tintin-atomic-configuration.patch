@@ -0,0 +1,341 @@
+// Unit boundaries: real AgentManager, fake runner and atomic SDK session. No native/provider execution.
+import { mkdirSync, mkdtempSync, rmSync, writeFileSync } from "node:fs";
+import { join } from "node:path";
+import type { AgentSession, ExtensionAPI, ExtensionContext } from "@earendil-works/pi-coding-agent";
+import * as piSdk from "@earendil-works/pi-coding-agent";
+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+import { AgentManager } from "../src/agent-manager.js";
+import { resumeAgent, runAgent } from "../src/agent-runner.js";
+import { type AtomicConfigurationRequest, type ChildConfigurationReceipt, type ChildConfigurationSnapshot, IdleChildControls } from "../src/idle-child-configuration.js";
+
+vi.mock("../src/agent-runner.js", () => ({ runAgent: vi.fn(), resumeAgent: vi.fn() }));
+vi.mock("@earendil-works/pi-coding-agent", () => ({
+  getAgentDir: () => process.env.PI_CODING_AGENT_DIR,
+  // Unit resolver double, not evidence of native Pi pattern semantics.
+  resolveModelScopeFromModels: vi.fn((patterns: string[], models: { provider: string; id: string }[]) => {
+    const selected = models.filter(m => patterns.some(p => p === `${m.provider}/*` || p === `${m.provider}/${m.id}`));
+    return { scopedModels: selected.map(model => ({ model })), diagnostics: selected.length ? [] : [{ kind: "no-match" }] };
+  }),
+}));
+
+function atomicSession() {
+  let snapshot: ChildConfigurationSnapshot = { sessionId: "child-session", revision: 0, model: { provider: "local", id: "a" }, thinkingLevel: "off" };
+  const receipts = new Map<string, ChildConfigurationReceipt>();
+  let release = () => {};
+  let gate = Promise.resolve();
+  const session = {
+    dispose: vi.fn(),
+    steer: vi.fn(async () => "queued"),
+    getConfigurationSnapshot: () => Object.freeze({ ...snapshot }),
+    getConfigurationReceipt: (id: string) => receipts.get(id),
+    configureIfIdle: vi.fn(async (request: AtomicConfigurationRequest) => {
+      await gate;
+      if (request.signal?.aborted) return { status: "rejected" as const, operationId: request.operationId, reason: "cancelled" as const };
+      if (!request.validateCommit?.()) return { status: "rejected" as const, operationId: request.operationId, reason: "unauthorized" as const };
+      const before = snapshot;
+      const noop = before.model?.id === request.target.id && before.thinkingLevel === request.target.thinkingLevel;
+      snapshot = { ...before, revision: before.revision + (noop ? 0 : 1), model: { provider: request.target.provider, id: request.target.id }, thinkingLevel: request.target.thinkingLevel };
+      const result: ChildConfigurationReceipt = { status: noop ? "noop" : "committed", operationId: request.operationId, before, after: snapshot, revision: snapshot.revision, notificationErrors: ["unit notification failure"] };
+      if (!noop) receipts.set(request.operationId, result);
+      return result;
+    }),
+  };
+  return { session, pause: () => { gate = new Promise<void>(resolve => { release = resolve; }); }, release: () => release() };
+}
+
+describe("retained idle child configuration (unit)", () => {
+  let dir: string;
+  let manager: AgentManager;
+  let controls: IdleChildControls;
+  let ctx: ExtensionContext;
+  let active: ExtensionContext | undefined;
+  let epoch: number;
+  let ownsRegistry: boolean;
+  let owner: string;
+  let child: ReturnType<typeof atomicSession>;
+  let id: string;
+  const request = (operationId = "op") => ({ operationId, childId: id, expectedSessionId: "child-session", expectedRevision: 0, model: { provider: "local", id: "b" }, thinking: "high" as const });
+  const settings = (text: string) => writeFileSync(join(dir, ".pi", "settings.json"), text);
+
+  beforeEach(async () => {
+    dir = mkdtempSync(join(process.cwd(), ".control-test-"));
+    mkdirSync(join(dir, ".pi"));
+    mkdirSync(join(dir, "global"));
+    vi.stubEnv("PI_CODING_AGENT_DIR", join(dir, "global"));
+    child = atomicSession();
+    owner = "root";
+    epoch = 0;
+    ownsRegistry = true;
+    ctx = { cwd: dir, sessionManager: { getSessionId: () => owner }, modelRegistry: { getAll: () => [{ provider: "local", id: "a" }, { provider: "local", id: "b" }] } } as unknown as ExtensionContext;
+    active = ctx;
+    manager = new AgentManager(undefined, 1);
+    controls = new IdleChildControls(manager, () => ({ ctx: active, epoch, ownsRegistry }));
+    vi.mocked(runAgent).mockImplementation(async (_ctx, _type, _prompt, options) => {
+      options.onSessionCreated?.(child.session as unknown as AgentSession);
+      return { responseText: "done", session: child.session as unknown as AgentSession, aborted: false, steered: false };
+    });
+    vi.mocked(resumeAgent).mockResolvedValue({ text: "resumed" });
+    id = manager.spawn({} as ExtensionAPI, ctx, "general-purpose", "run", { description: "unit", rootSessionId: "forged-lineage" });
+    await manager.getRecord(id)!.promise;
+    await manager.awaitStartup(id);
+  });
+  afterEach(async () => { await manager.dispose(); rmSync(dir, { recursive: true, force: true }); vi.unstubAllEnvs(); vi.clearAllMocks(); });
+
+  it("reads snapshots and commits with diagnostic receipts, without defaults or resume", async () => {
+    expect(controls.getIdleChildConfigurationSnapshot(id)).toMatchObject({ status: "ready", snapshot: { sessionId: "child-session", revision: 0 } });
+    const result = await controls.configureIdleChild(request());
+    expect(result).toMatchObject({ status: "committed", revision: 1, notificationErrors: ["unit notification failure"] });
+    expect(controls.getIdleChildConfigurationReceipt(request())).toBe(result);
+    expect(resumeAgent).not.toHaveBeenCalled();
+  });
+  it("returns noop without a committed receipt", async () => {
+    expect(await controls.configureIdleChild({ ...request(), model: { provider: "local", id: "a" }, thinking: "off" })).toMatchObject({ status: "noop" });
+    expect(controls.getIdleChildConfigurationReceipt(request())).toMatchObject({ status: "rejected", reason: "not-found" });
+  });
+  it("fails closed when the child lacks the atomic public API", () => {
+    Object.assign(child.session, { configureIfIdle: undefined });
+    expect(controls.getIdleChildConfigurationSnapshot(id)).toMatchObject({ status: "rejected", reason: "unsupported" });
+  });
+  it.each(["current", "epoch", "registry", "root", "record-owner", "session", "remove", "dispose", "steers"])("denies %s changes during deferred auth", async change => {
+    child.pause();
+    const pending = controls.configureIdleChild(request());
+    if (change === "current") active = { ...ctx };
+    if (change === "epoch") epoch++;
+    if (change === "registry") ownsRegistry = false;
+    if (change === "root") owner = "another";
+    if (change === "record-owner") manager.getRecord(id)!.workflowId = "wf";
+    if (change === "session") manager.getRecord(id)!.session = {} as AgentSession;
+    if (change === "remove") manager.clearCompleted();
+    if (change === "dispose") await manager.dispose();
+    if (change === "steers") manager.getRecord(id)!.pendingSteers = ["pending"];
+    child.release();
+    expect(await pending).toMatchObject({ status: "rejected", reason: "unauthorized" });
+    expect(child.session.getConfigurationSnapshot().revision).toBe(0);
+  });
+  it("invalidates completed foreground-run ABA while auth waits", async () => {
+    child.pause();
+    const pending = controls.configureIdleChild(request());
+    await manager.resume(id, "again");
+    expect(manager.getRecord(id)!.status).toBe("completed");
+    child.release();

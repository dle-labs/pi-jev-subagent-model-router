+// Unit integration: actual extension registry/lifecycle, fake runner and atomic session.
+import { mkdirSync, mkdtempSync, rmSync, writeFileSync } from "node:fs";
+import { join } from "node:path";
+import type { AgentSession, ExtensionAPI, ExtensionContext } from "@earendil-works/pi-coding-agent";
+import * as piSdk from "@earendil-works/pi-coding-agent";
+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+import * as runner from "../src/agent-runner.js";
+import type { AtomicConfigurationRequest, ChildConfigurationSnapshot, IdleChildControls } from "../src/idle-child-configuration.js";
+import extension from "../src/index.js";
+
+const feature = vi.hoisted(() => ({ enabled: true }));
+vi.mock("@earendil-works/pi-coding-agent", async () => {
+  const actual = await vi.importActual<typeof piSdk>("@earendil-works/pi-coding-agent");
+  return { ...actual, get resolveModelScopeFromModels() { return feature.enabled ? () => ({ scopedModels: [], diagnostics: [] }) : undefined; } };
+});
+vi.mock("../src/agent-runner.js", async () => {
+  const actual = await vi.importActual<typeof runner>("../src/agent-runner.js");
+  return { ...actual, runAgent: vi.fn() };
+});
+const KEY = Symbol.for("pi-subagents:manager");
+type Registry = Pick<IdleChildControls, "configureIdleChild" | "getIdleChildConfigurationSnapshot" | "getIdleChildConfigurationReceipt"> & {
+  spawn(pi: ExtensionAPI, ctx: ExtensionContext, type: string, prompt: string, options: { description: string; isBackground: boolean }): string;
+  waitForAll(): Promise<void>;
+};
+
+describe("idle child registry lifecycle (unit)", () => {
+  let dir: string;
+  let previousCwd: string;
+  let ctx: ExtensionContext;
+  let registry: Registry;
+  let pi: ExtensionAPI;
+  let handlers: Map<string, (event: unknown, ctx: ExtensionContext) => Promise<void>>;
+  let release: () => void;
+  let gate: Promise<void>;
+  let configure: ReturnType<typeof vi.fn>;
+  const request = (childId: string, operationId = "op") => ({ operationId, childId, expectedSessionId: "child", expectedRevision: 0, model: { provider: "local", id: "b" }, thinking: "off" as const });
+  const spawn = async () => {
+    const id = registry.spawn(pi, ctx, "general-purpose", "unit", { description: "unit", isBackground: true });
+    await registry.waitForAll();
+    return id;
+  };
+  beforeEach(() => {
+    dir = mkdtempSync(join(process.cwd(), ".registry-test-"));
+    mkdirSync(join(dir, ".pi"));
+    writeFileSync(join(dir, ".pi", "subagents.json"), JSON.stringify({ schedulingEnabled: false, workflowsEnabled: false, fleetView: false, widgetMode: "off" }));
+    vi.stubEnv("HOME", dir); vi.stubEnv("PI_CODING_AGENT_DIR", join(dir, "global"));
+    previousCwd = process.cwd(); process.chdir(dir);
+    feature.enabled = true;
+    handlers = new Map();
+    pi = {
+      registerMessageRenderer: vi.fn(), registerEntryRenderer: vi.fn(), registerFlag: vi.fn(), getFlag: vi.fn(),
+      registerTool: vi.fn(), registerCommand: vi.fn(), appendEntry: vi.fn(), sendMessage: vi.fn(),
+      on: (name: string, handler: (event: unknown, ctx: ExtensionContext) => Promise<void>) => handlers.set(name, handler),
+      events: { emit: vi.fn(), on: vi.fn(() => vi.fn()) },
+    } as unknown as ExtensionAPI;
+    ctx = { cwd: dir, hasUI: false, ui: { notify: vi.fn() }, sessionManager: { getSessionId: () => "root", getBranch: () => [] }, modelRegistry: { getAll: () => [] } } as unknown as ExtensionContext;
+    gate = new Promise<void>(resolve => { release = resolve; });
+    const snapshot: ChildConfigurationSnapshot = { sessionId: "child", revision: 0, model: { provider: "local", id: "a" }, thinkingLevel: "off" };
+    configure = vi.fn(async (input: AtomicConfigurationRequest) => {
+      await gate;
+      return input.validateCommit?.()
+        ? { status: "noop", operationId: input.operationId, before: snapshot, after: snapshot, revision: 0, notificationErrors: [] }
+        : { status: "rejected", operationId: input.operationId, reason: "unauthorized" };
+    });
+    const session = { dispose: vi.fn(), getConfigurationSnapshot: () => snapshot, configureIfIdle: configure, getConfigurationReceipt: () => undefined } as unknown as AgentSession;
+    vi.mocked(runner.runAgent).mockImplementation(async (_c, _t, _p, options) => {
+      options.onSessionCreated?.(session);
+      return { responseText: "done", session, aborted: false, steered: false };
+    });
+    delete (globalThis as Record<symbol, unknown>)[KEY];
+    extension(pi);
+    registry = (globalThis as Record<symbol, unknown>)[KEY] as Registry;
+  });
+  afterEach(async () => {
+    await handlers.get("session_shutdown")!({}, ctx);
+    delete (globalThis as Record<symbol, unknown>)[KEY];
+    process.chdir(previousCwd); rmSync(dir, { recursive: true, force: true }); vi.unstubAllEnvs(); vi.clearAllMocks();
+  });
+  it("registers exact public names but refuses controls before session_start", () => {
+    expect(registry.getIdleChildConfigurationSnapshot).toBeTypeOf("function");
+    expect(registry.configureIdleChild).toBeTypeOf("function");
+    expect(registry.getIdleChildConfigurationReceipt).toBeTypeOf("function");
+    expect(registry.getIdleChildConfigurationSnapshot("missing")).toMatchObject({ reason: "unauthorized" });
+  });
+  it("keeps ordinary spawning available when the new public Pi export is absent", async () => {
+    feature.enabled = false;
+    await handlers.get("session_start")!({}, ctx);
+    const id = await spawn();
+    expect(id).toBeTruthy();
+    expect(registry.getIdleChildConfigurationSnapshot(id)).toMatchObject({ reason: "unsupported" });
+    expect(await registry.configureIdleChild(request(id))).toMatchObject({ reason: "unsupported" });
+    expect(configure).not.toHaveBeenCalled();
+  });
+  it.each(["switch", "rebind", "shutdown", "registry"])("invalidates deferred configuration on %s", async change => {
+    await handlers.get("session_start")!({}, ctx);
+    const id = await spawn();
+    expect(registry.getIdleChildConfigurationSnapshot(id)).toMatchObject({ status: "ready", childId: id });
+    const pending = registry.configureIdleChild(request(id));
+    if (change === "switch") await handlers.get("session_before_switch")!({}, ctx);
+    if (change === "rebind") await handlers.get("session_start")!({}, ctx);
+    if (change === "shutdown") await handlers.get("session_shutdown")!({}, ctx);
+    if (change === "registry") (globalThis as Record<symbol, unknown>)[KEY] = {};
+    release();
+    expect(await pending).toMatchObject({ status: "rejected", reason: "unauthorized" });
+    if (change === "switch") {
+      // A cancelled switch does not fire session_start: the old context must still work.
+      expect(await registry.configureIdleChild(request(id, "after-cancelled-switch"))).toMatchObject({ status: "noop" });
+    }
+  });
+});

+import type { Model } from "@earendil-works/pi-ai";
+import { describe, expect, it } from "vitest";
+import * as sdk from "../src/index.ts";
+
+const model: Model<string> = {
+	id: "one",
+	provider: "local",
+	name: "One",
+	api: "faux",
+	baseUrl: "https://example.invalid",
+	reasoning: true,
+	input: ["text"],
+	contextWindow: 1000,
+	maxTokens: 100,
+	cost: { input: 0, output: 0, cacheRead: 0, cacheWrite: 0 },
+};
+
+describe("public synchronous model scope resolution", () => {
+	it("exports a synchronous resolver over the caller's actual registry universe", () => {
+		expect(sdk.resolveModelScopeFromModels).toBeTypeOf("function");
+		const result = sdk.resolveModelScopeFromModels(["local/*:high"], [model]);
+		expect(result).not.toBeInstanceOf(Promise);
+		expect(result).toEqual({ scopedModels: [{ model, thinkingLevel: "high" }], diagnostics: [] });
+		expect(result.scopedModels[0].model).toBe(model);
+	});
+
+	it("preserves no-match diagnostics and an empty scope rather than failing open", () => {
+		const result = sdk.resolveModelScopeFromModels(["absent/*"], [model]);
+		expect(result.scopedModels).toEqual([]);
+		expect(result.diagnostics).toMatchObject([{ code: "no-match", pattern: "absent/*" }]);
+	});
+});

+import { syncBuiltinESMExports } from "node:module";
+import { join } from "node:path";
+import fs from "fs";
+import { afterEach, describe, expect, it, vi } from "vitest";
+import { SessionManager } from "../src/core/session-manager.ts";
+
+describe("atomic configuration transcript append", () => {
+	const directories: string[] = [];
+	afterEach(() => {
+		vi.restoreAllMocks();
+		syncBuiltinESMExports();
+		for (const directory of directories.splice(0)) fs.rmSync(directory, { recursive: true, force: true });
+	});
+
+	function persisted(conversation = true) {
+		const directory = fs.mkdtempSync(join(process.cwd(), ".configuration-test-"));
+		directories.push(directory);
+		const manager = SessionManager.create(directory, directory);
+		if (conversation) manager.appendMessage({ role: "user", content: "hello", timestamp: 1 });
+		return { manager, directory, file: manager.getSessionFile()! };
+	}
+
+	it("publishes both existing entry types with the exact parent chain", () => {
+		const { manager, file } = persisted();
+		const parent = manager.getLeafId();
+		const [model, thinking] = manager.appendConfigurationChange("faux", "two", "high");
+		expect(model).toMatchObject({ type: "model_change", parentId: parent, provider: "faux", modelId: "two" });
+		expect(thinking).toMatchObject({ type: "thinking_level_change", parentId: model.id, thinkingLevel: "high" });
+		expect(manager.getLeafId()).toBe(thinking.id);
+		expect(SessionManager.open(file).getEntries()).toEqual(manager.getEntries());
+	});
+
+	it("keeps setup-only persistence deferred", () => {
+		const { manager, file } = persisted(false);
+		manager.appendConfigurationChange("faux", "two", "high");
+		expect(fs.existsSync(file)).toBe(false);
+		manager.appendMessage({ role: "user", content: "hello", timestamp: 1 });
+		expect(SessionManager.open(file).getEntries()).toEqual(manager.getEntries());
+	});
+
+	it("preserves restrictive existing permissions", () => {
+		const { manager, file } = persisted();
+		fs.chmodSync(file, 0o600);
+		manager.appendConfigurationChange("faux", "two", "high");
+		expect(fs.statSync(file).mode & 0o777).toBe(0o600);
+	});
+
+	for (const operation of ["openSync", "fchmodSync", "writeFileSync", "fsyncSync", "renameSync"] as const) {
+		it(`leaves disk, entries, index and leaf unchanged on ${operation} failure`, () => {
+			const { manager, file, directory } = persisted();
+			const disk = fs.readFileSync(file, "utf8");
+			const entries = manager.getEntries();
+			const leaf = manager.getLeafId();
+			vi.spyOn(fs, operation).mockImplementationOnce(() => {
+				throw new Error("storage failure");
+			});
+			syncBuiltinESMExports();
+			expect(() => manager.appendConfigurationChange("faux", "two", "high")).toThrow("storage failure");
+			expect(fs.readFileSync(file, "utf8")).toBe(disk);
+			expect(manager.getEntries()).toEqual(entries);
+			expect(manager.getEntryCount()).toBe(entries.length);
+			expect(manager.getLeafId()).toBe(leaf);
+			expect(fs.readdirSync(directory)).toEqual([file.slice(directory.length + 1)]);
+		});
+	}
+
+	it("does not publish after close failure", () => {
+		const { manager, file, directory } = persisted();
+		const disk = fs.readFileSync(file, "utf8");
+		const entries = manager.getEntries();
+		const close = fs.closeSync;
+		vi.spyOn(fs, "closeSync").mockImplementationOnce((fd) => {
+			close(fd);
+			throw new Error("close failed");
+		});
+		syncBuiltinESMExports();
+		expect(() => manager.appendConfigurationChange("faux", "two", "high")).toThrow("close failed");
+		expect(fs.readFileSync(file, "utf8")).toBe(disk);
+		expect(manager.getEntries()).toEqual(entries);
+		expect(fs.readdirSync(directory)).toHaveLength(1);
+	});
+
+	it("does not publish after serialization failure", () => {
+		const { manager, file, directory } = persisted();
+		let fail = false;
+		manager.appendCustomEntry("data", {
+			toJSON() {
+				if (fail) throw new Error("serialization failed");
+				return "ok";
+			},
+		});
+		const disk = fs.readFileSync(file, "utf8");
+		const entries = manager.getEntries();
+		fail = true;
+		expect(() => manager.appendConfigurationChange("faux", "two", "high")).toThrow("serialization failed");
+		expect(fs.readFileSync(file, "utf8")).toBe(disk);
+		expect(manager.getEntries()).toEqual(entries);
+		expect(fs.readdirSync(directory)).toHaveLength(1);
+	});
+
+	it.each([false, true])("runs the final guard before publishing (persisted=%s)", (persistent) => {
+		const manager = persistent ? persisted().manager : SessionManager.inMemory();
+		const entries = manager.getEntries();
+		const file = manager.getSessionFile();
+		const disk = file ? fs.readFileSync(file, "utf8") : undefined;
+		expect(() =>
+			manager.appendConfigurationChange("faux", "two", "high", () => {
+				throw new Error("stale");
+			}),
+		).toThrow("stale");
+		expect(manager.getEntries()).toEqual(entries);
+		if (file) expect(fs.readFileSync(file, "utf8")).toBe(disk);
+	});
+
+	it.each(["memory", "deferred", "persisted"] as const)("retains a guard's append in %s history", (kind) => {
+		const manager = kind === "memory" ? SessionManager.inMemory() : persisted(kind === "persisted").manager;
+		expect(() =>
+			manager.appendConfigurationChange("faux", "two", "high", () => {
+				manager.appendSessionInfo("accepted");
+			}),
+		).toThrow("Session changed during configuration staging");
+		expect(
+			manager
+				.getEntries()
+				.filter((entry) => entry.type === "model_change" || entry.type === "thinking_level_change"),
+		).toEqual([]);
+		expect(manager.getSessionName()).toBe("accepted");
+		const file = manager.getSessionFile();
+		if (kind === "persisted") expect(SessionManager.open(file!).getSessionName()).toBe("accepted");
+		if (kind === "deferred") expect(fs.existsSync(file!)).toBe(false);
+	});
+
+	it("refuses guard replacement of the same session ID and retains the new tree", () => {
+		const manager = SessionManager.inMemory();
+		const id = manager.getSessionId();
+		expect(() =>
+			manager.appendConfigurationChange("faux", "two", "high", () => {
+				manager.newSession({ id });
+			}),
+		).toThrow("Session changed during configuration staging");
+		expect(manager.getSessionId()).toBe(id);
+		expect(manager.getEntries()).toEqual([]);
+		expect(manager.getLeafId()).toBeNull();
+	});
+
+	it("refuses a changed leaf without losing the guard's navigation", () => {
+		const { manager } = persisted();
+		const parent = manager.getLeafId()!;
+		manager.appendSessionInfo("second");
+		expect(() =>
+			manager.appendConfigurationChange("faux", "two", "high", () => {
+				manager.branch(parent);
+			}),
+		).toThrow("Session changed during configuration staging");
+		expect(manager.getLeafId()).toBe(parent);
+		expect(manager.getEntryCount()).toBe(2);
+	});
+
+	it("rejects invalid in-memory input without publishing either entry", () => {
+		const manager = SessionManager.inMemory();
+		expect(() => manager.appendConfigurationChange("", "two", "high")).toThrow(
+			"Configuration values must be non-empty strings",
+		);
+		expect(manager.getEntries()).toEqual([]);
+		expect(manager.getLeafId()).toBeNull();
+	});
+});

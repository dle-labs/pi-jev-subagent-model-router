@@ -0,0 +1,51 @@
+import { describe, expect, it } from "vitest";
+import { Agent } from "../src/agent.ts";
+
+function createAgent() {
+	return new Agent({
+		streamFn: () => {
+			throw new Error("No provider calls expected");
+		},
+	});
+}
+
+describe("native activity revision", () => {
+	it.each(["steer", "followUp"] as const)("retains %s admission after clearing queues", (method) => {
+		const agent = createAgent();
+		const initial = agent.activityRevision;
+		expect(initial).toBe(0);
+		agent[method]({ role: "user", content: "queued", timestamp: 1 });
+		const queued = agent.activityRevision;
+		expect(queued).toBeGreaterThan(initial);
+		expect(agent.hasQueuedMessages()).toBe(true);
+		agent.clearAllQueues();
+		expect(agent.activityRevision).toBeGreaterThan(queued);
+		expect(agent.hasQueuedMessages()).toBe(false);
+		expect(agent.state.messages).toEqual([]);
+	});
+
+	it("tracks supported queue-mode mutations and reset without resetting the revision", () => {
+		const agent = createAgent();
+		let before = agent.activityRevision;
+		agent.steeringMode = "all";
+		expect(agent.activityRevision).toBeGreaterThan(before);
+		before = agent.activityRevision;
+		agent.followUpMode = "all";
+		expect(agent.activityRevision).toBeGreaterThan(before);
+		before = agent.activityRevision;
+		agent.reset();
+		expect(agent.activityRevision).toBeGreaterThan(before);
+		expect(agent.steeringMode).toBe("all");
+		expect(agent.followUpMode).toBe("all");
+	});
+
+	it("tracks run admission even when the run fails and settles", async () => {
+		const agent = createAgent();
+		const before = agent.activityRevision;
+		const run = agent.prompt("hello");
+		expect(agent.activityRevision).toBeGreaterThan(before);
+		await run;
+		expect(agent.activityRevision).toBeGreaterThan(before);
+		expect(agent.state.isStreaming).toBe(false);
+	});
+});
